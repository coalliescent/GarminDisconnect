# tools/mac_build.local.env.example — copy to tools/mac_build.local.env.
#
#     cp tools/mac_build.local.env.example tools/mac_build.local.env
#
# Which Mac `make mac-build` / `make mac-test` build on is a property of your
# machines, not of this project, so the real file is git-ignored and never
# committed. Sourced by tools/mac_build.sh; plain shell assignments only.
#
# Anything you also export in your environment takes precedence over this file.

# ssh destination of a Mac with a Swift toolchain. Key auth is assumed — the
# script runs several non-interactive ssh/rsync commands per build.
MAC_BUILD_HOST=user@your-mac.local

# Scratch directory on that host. Optional; this is the default.
#
# Quote any leading `~`: this file is sourced by your local shell, so an
# unquoted tilde expands to *your* home directory and gets sent to the remote
# host as an absolute path that very likely does not exist there. Quoted, it
# travels intact and the remote shell expands it.
#MAC_BUILD_DIR='~/build/GarminDisconnect'
