# Build artifacts
build/
*.dSYM

# macOS
.DS_Store

# Personal Garmin data (FIT files contain device serials + health telemetry).
# Both cases matter: the watch names activity/sleep files `*.fit` but monitor
# files `*.FIT`, and git's patterns are case-sensitive.
*.fit
*.FIT

# ...except the synthetic parser fixtures, which are generated by
# garmin-dump/tests/fixtures/build_fit_fixtures.py and contain no real data.
!garmin-dump/tests/fixtures/*.fit
!garmin-dump/tests/fixtures/*.FIT

# Python (used by garmin-dump/)
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# IDE
.vscode/
.idea/
